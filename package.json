{
  "name": "env-veil",
  "displayName": "Env Veil",
  "description": "Prevents accidental on-screen exposure of .env values.",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#151D2E",
    "theme": "dark"
  },
  "keywords": [
    "env",
    "dotenv",
    "secrets",
    "mask",
    "masking",
    "redact",
    "security",
    "privacy",
    "environment"
  ],
  "version": "0.0.1",
  "publisher": "Ku6epXBOCTuK",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCustomEditor:envVeil.protectedEnv",
    "onLanguage:dotenv",
    "onCommand:envVeil.revealValues",
    "onCommand:envVeil.hideValues",
    "onCommand:envVeil.openInConfiguredEditor"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "envVeil.revealValues",
        "title": "Env Veil: Reveal Values"
      },
      {
        "command": "envVeil.hideValues",
        "title": "Env Veil: Hide Values"
      },
      {
        "command": "envVeil.openInConfiguredEditor",
        "title": "Env Veil: Open in Configured Editor"
      }
    ],
    "configuration": {
      "title": "Env Veil",
      "properties": {
        "envVeil.revealTimeoutSeconds": {
          "type": "integer",
          "default": 15,
          "minimum": 1,
          "maximum": 3600,
          "scope": "window",
          "description": "Seconds before revealed values are hidden again."
        },
        "envVeil.openIn.mode": {
          "type": "string",
          "enum": [
            "vscode",
            "external"
          ],
          "default": "vscode",
          "scope": "window",
          "description": "Editor used by Open in Editor."
        },
        "envVeil.externalEditor.command": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Executable used by the external editor, for example subl or an absolute path."
        },
        "envVeil.externalEditor.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "machine",
          "description": "Arguments passed before the file path. Use {file} and {workspaceFolder} placeholders."
        }
      }
    },
    "customEditors": [
      {
        "viewType": "envVeil.protectedEnv",
        "displayName": "Env Veil",
        "selector": [
          {
            "filenamePattern": "**/.env"
          },
          {
            "filenamePattern": "**/.env.*"
          }
        ],
        "priority": "default"
      }
    ]
  },
  "scripts": {
    "clean": "node -e \"const fs = require('node:fs'); fs.rmSync('dist', { recursive: true, force: true }); fs.rmSync('out', { recursive: true, force: true });\"",
    "compile": "npm run typecheck && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "compile:tests": "tsc -p tsconfig.test.json",
    "pretest": "npm run compile && npm run compile:tests",
    "test": "vscode-test",
    "package:inspect": "vsce ls",
    "vscode:prepublish": "npm run typecheck && node esbuild.mjs --production",
    "package": "vsce package --out dist/env-veil.vsix"
  },
  "overrides": {
    "mocha": "12.0.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/cross-spawn": "^6.0.6",
    "@types/mocha": "10.0.10",
    "@types/node": "24.13.5",
    "@types/vscode": "1.105.0",
    "@vscode/test-cli": "0.0.15",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "mocha": "12.0.2",
    "typescript": "6.0.2",
    "typescript-eslint": "8.70.1"
  },
  "dependencies": {
    "cross-spawn": "^7.0.6"
  }
}
