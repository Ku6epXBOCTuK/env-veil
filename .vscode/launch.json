{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Env Veil",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--disable-extension=marant.the-env-guard",
        "--extensionDevelopmentPath=${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js"
      ],
      "preLaunchTask": "npm: compile"
    }
  ]
}
